# .env — конфигурация окружения
# ВАЖНО: добавить .env в .gitignore — не коммитить в git!

# По заданию: FakeStore API (не требует ключа, но блокирует localhost через CORS)
# API_BASE_URL=https://fakestoreapi.com

# Используется как замена (работает с localhost):
API_BASE_URL=https://dummyjson.com

# Stripe API (для платежей) — требует серверной интеграции
# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx  # только на сервере, никогда на клиенте!

# Shopify API
# SHOPIFY_API_KEY=your_shopify_key_here
# SHOPIFY_STORE_URL=your-store.myshopify.com